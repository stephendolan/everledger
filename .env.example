# Copy the settings you need into the process environment; this file is not loaded.
# No value here is a real credential.

# HOME supplies the default data path; when absent it falls back to .
# HOME is normally supplied by the shell. Do not replace it to configure this tool.
# EVERLEDGER_DATA_DIR defaults to $HOME/.everledger.
EVERLEDGER_DATA_DIR=/home/you/.everledger

# Self-hosted companion service for characters, inventory, listings and outcomes.
EVERLEDGER_ROSTER_URL=http://localhost:8765
# A nonblank token wins over the file. Both default to unset.
EVERLEDGER_ROSTER_TOKEN=
EVERLEDGER_ROSTER_TOKEN_FILE=

EVERLEDGER_MARKET=forever.pvp.alliance.us
EVERLEDGER_AHLEDGER_URL=https://api.ahledger.com
EVERLEDGER_VENDOR_URL=https://wowforever.ninja

# Optional ForeverDB backend: configuration and a complete sync activate it.
# A nonblank key wins over the file; both settings default to unset.
EVERLEDGER_FOREVERDB_API_KEY=
# An unset or empty path uses $EVERLEDGER_DATA_DIR/foreverdb-api-key.
EVERLEDGER_FOREVERDB_API_KEY_FILE=

# A nonblank connector slug (for example custom.foreverdb) wins over key settings.
EVERLEDGER_FOREVERDB_VIA_CONNECTOR=
EVERLEDGER_DYNAMIC_CREDENTIALS_DIR=/opt/muse/skills/custom-connector-setup/bin

# Positive integer requests per rolling 24 hours, across attempts and retries.
# Invalid values fail every command, including help.
EVERLEDGER_FOREVERDB_DAILY_REQUESTS=36
