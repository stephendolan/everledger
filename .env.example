# everledger configuration. Copy the values you need into your environment.
# Nothing here is a real credential.

# Where the local catalogue lives (default: ~/.everledger)
EVERLEDGER_DATA_DIR=/home/you/.everledger

# Companion roster service for characters, listings, positions and outcomes.
# Also supplies known-by annotations on recipes. Self-hosted; not part of this repo.
EVERLEDGER_ROSTER_URL=http://localhost:8765

# Roster service bearer token: either the token itself...
EVERLEDGER_ROSTER_TOKEN=
# ...or a path to a file containing it (mode 600 recommended).
EVERLEDGER_ROSTER_TOKEN_FILE=

# AHledger market to price against (default: forever.pvp.alliance.us,
# Alliance, PvP, US).
EVERLEDGER_MARKET=forever.pvp.alliance.us

# Source URL overrides (defaults shown; also useful for fixture servers).
EVERLEDGER_AHLEDGER_URL=https://api.ahledger.com
EVERLEDGER_VENDOR_URL=https://wowforever.ninja

# Optional ForeverDB vendor backend. Dormant until a key AND complete sync exist.
EVERLEDGER_FOREVERDB_API_KEY=
# Explicit file overrides the default: $EVERLEDGER_DATA_DIR/foreverdb-api-key.
# A nonempty API_KEY environment value takes precedence over either file.
EVERLEDGER_FOREVERDB_API_KEY_FILE=
