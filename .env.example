# everledger configuration. Copy the values you need into your environment.
# Nothing here is a real credential.

# Where the local catalogue lives (default: ~/.everledger)
EVERLEDGER_DATA_DIR=/home/you/.everledger

# Companion roster service (only needed for the `char` command and the
# known-by annotation on `recipe`). Self-hosted; not part of this repo.
EVERLEDGER_ROSTER_URL=http://localhost:8765

# Roster service bearer token: either the token itself...
EVERLEDGER_ROSTER_TOKEN=
# ...or a path to a file containing it (mode 600 recommended).
EVERLEDGER_ROSTER_TOKEN_FILE=

# AHledger market to price against (default: forever.pvp.alliance.us,
# Alliance, PvP, US).
EVERLEDGER_MARKET=forever.pvp.alliance.us
