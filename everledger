'''


def parser():
    p = argparse.ArgumentParser(description=__doc__, epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter, allow_abbrev=False)
    sub = p.add_subparsers(dest='command', required=True)
    specs = [
        ('price', 'AHledger quote plus vendor listed prices', [('item', {'nargs':'+'})]),
        ('recipe', 'Catalogue facts and roster known-by annotation', [('item', {'nargs':'+'}), ('--skill', {'type':int})]),
        ('bridge', 'Catalogue skill-up bands across a range', [('profession', {}), ('start', {'type':int}), ('end', {'type':int})]),
        ('margins', 'AHledger craft margins; optional roster recipe/level scope', [('profession', {'nargs':'?'}), ('--level', {'type':int}), ('--char', {}), ('--known', {'help':argparse.SUPPRESS})]),
        ('vendors', 'Vendor listed prices/locations; ForeverDB includes faction', [('item', {'nargs':'+'}), ('--in', {'dest':'zone','help':'zone/city substring; aliases IF, SW, Darn, Org, TB, UC'}), ('--char', {'help':'character scope; faction filtering unavailable'}), ('--all', {'action':'store_true','help':'all zones (also the default; no faction filtering)'})]),
        ('char', 'Characters, profession ranks and known recipes', [('name', {'nargs':'?'}), ('profession', {'nargs':'?'}), ('--skill', {'type':int})]),
        ('listings', 'Recorded live auction listings and AHledger floor comparison', [('--char', {}), ('--item', {})]),
        ('positions', 'Inventory holdings/listings and AHledger floor; basis unknown without assignments', [('--char', {}), ('--item', {})]),
        ('sales', 'Sales proceeds (defaults to auction)', []),
        ('purchases', 'Auction and vendor purchases', []),
        ('expirations', 'Expired auctions with market repost inputs', []),
        ('net', 'Item auction cash/count diagnostic; profit basis stays unknown', [('item', {'nargs':'+'})]),
        ('events', 'Typed journal feed; prints next_cursor, has_more and service checkpoint', []),
        ('status', 'Reachability/freshness of AHledger, roster, outcomes, catalogue and vendors', []),
        ('refresh', 'Rebuild catalogue and refresh the configured vendor backend', [('target', {'nargs':'?','choices':['catalogue']})]),
        ('verify', 'Deprecated catalogue anchor check (use status)', []),
    ]
    for name, help_text, arguments in specs:
        c = sub.add_parser(name, help=help_text, description=help_text, allow_abbrev=False)
        for flag, kwargs in arguments:
            c.add_argument(flag, **kwargs)
        if name in ('sales', 'purchases', 'expirations', 'events', 'net', 'positions'):
            if name != 'net' and name != 'positions':
                c.add_argument('--item')
                c.add_argument('--char')
            if name == 'net':
                c.add_argument('--char')
            if name != 'positions':
                c.add_argument('--since')
                c.add_argument('--until')
        if name in ('sales', 'purchases', 'events'):
            c.add_argument('--venue', choices=['auction', 'vendor'], default='auction' if name == 'sales' else None)
        if name == 'events':
            c.add_argument('--type', help='comma-separated purchase, sale, posting, expiration, cancellation')
            c.add_argument('--cursor', help='snapshot page cursor from next_cursor; inherits fixed filters')
            c.add_argument('--after', help='terminal after_cursor/checkpoint; exclusive with since/until')
            c.add_argument('--limit', type=int, help='0 bootstraps a watch; default 50 human, 500 JSON')
            c.epilog = ('Start a watch: everledger events --limit 0 --json. Bootstrap drains a snapshot '
                        'with positive service limits and prints no entries. Save after_cursor (the service '
                        'terminal checkpoint) only after has_more is false. While has_more is true, pass '
                        'next_cursor to --cursor to finish the snapshot; page cursors retain the local view. '
                        'Character/item/type/venue filters are local views over an unfiltered checkpoint '
                        'and may change between polls. Limit bounds the scanned page, so a filtered page '
                        'may be empty with has_more true. Times are sent as integer epoch seconds. '
                        'On 409 cursor_invalid, alert once and resync from resync_since; retries can '
                        'replay entries. snapshot_changed requires restarting from the last committed '
                        'checkpoint. Act before saving progress for at-least-once delivery. '
                        'This CLI persists nothing.')
        c.add_argument('--json', action='store_true', help='one JSON document using API field names')
    return p


def capture(func, *args):
    output = io.StringIO()
    with contextlib.redirect_stdout(output):
        code = func(*args)
    return code, output.getvalue().splitlines()


def item_for(query):
    item = resolve_item(query)
    if item['name'] is None:
        try:
            cat = load_catalogue()
        except Failure:
            return item
        for _, r in recipes(cat):
            for candidate in [r['result'], *r['reagents']]:
                if candidate.get('item_id') == item['id']:
                    item['name'] = candidate['name']
                    return item
    return item


def disclose_item_source(data, item):
    if item and item.get('name'):
        cat_source = catalogue_source(load_catalogue())
        data['sources'] = sources(data)
        if cat_source not in data['sources']:
            data['sources'].append(cat_source)
    return data


def price(args):
    item = item_for(' '.join(args.item))
    raw, _ = request(f"{AHL}/v1/prices/{MARKET}/{item['id']}")
    data = json.loads(raw)
    latest, sales = data['latest'], data['sales']
    stamp = latest['observedAt']
    s = source('AHledger ' + MARKET, stamp, stale=age(stamp) is None or age(stamp) > 900)
    quote = {'item': data['item'], 'latest': {'observed_at': stamp,
        'median_copper': round(latest['median']) if latest['median'] is not None else None,
        'min_buyout_copper': round(latest['minBuyout']) if latest['minBuyout'] is not None else None,
        'median_7d_copper': round(latest['median7d']) if latest['median7d'] is not None else None,
        'quantity': latest['quantity'], 'auctions': latest['auctions']}, 'sales': sales, 'sources':[s]}
    v = vendors.lookup(item['id'])
    quote['vendors'] = v['vendors']
    quote['vendor_reason'] = v['reason']
    quote['sources'].extend(v['sources'])
    rate = f"est {sales['estimatedPerDay']}/day" if sales['estimatedPerDay'] is not None else 'sales/day unknown'
    coverage = f"{sales['coveredHours']}h coverage" if sales['coveredHours'] is not None else 'coverage unknown'
    lines = [f"{human(data['item']['name'])} (item {item['id']}) latest {human(stamp)}: median {money(latest['median'])}, min {money(latest['minBuyout'])}, listed {human(latest['quantity'])} in {human(latest['auctions'])} auctions | 7d median {money(latest['median7d'])} | {rate} over {coverage}"]
    if v['vendors']:
        if v['backend'] == vendors.foreverdb.BACKEND:
            offers = sorted({vendors.listed_price(row) + vendors.stock_label(row) for row in v['vendors']})
            lines.append('vendor: listed price ' + '; '.join(offers) + ' | ForeverDB sell-row labels')
        else:
            prices = [r['price_copper'] for r in v['vendors'] if r['price_copper'] is not None]
            lines.append(f"vendor: listed price {money(min(prices) if prices else None)} | 1.12 baseline sale/price; purchase quantity unknown")
    disclose_item_source(quote,item)
    emit(quote, lines, args.json)
    return stale_code(quote['sources'])


def recipe(args):
    cat = load_catalogue()
    hits = catalogue.find(cat, ' '.join(args.item))[:8]
    if not hits:
        raise Failure('no catalogue match')
    used = [catalogue_source(cat)]
    rows = [dict(r, profession=p) for p, r in hits]
    lines = [catalogue.fmt_recipe(p, r, args.skill) for p, r in hits]
    try:
        chars = roster('/characters')
        used += sources(chars)
        for (prof, r), row in zip(hits, rows):
            known_by, unavailable = [], []
            for ch in chars['characters']:
                ids = catalogue.char_known_ids(ch, prof)
                name = ch.get('name') or ch.get('short_name')
                if ids is None:
                    unavailable.append(name)
                elif r['spell_id'] in ids:
                    known_by.append(name)
            row.update(known_by=known_by, recipe_data_unavailable=unavailable)
            lines.append('  known by: ' + (', '.join(known_by) or 'no roster character') + ('; recipe data unavailable: ' + ', '.join(unavailable) if unavailable else ''))
    except Failure as e:
        for row in rows:
            row['known_by'] = None
        lines.append('known by: not checked (' + str(e) + ')')
    emit({'recipes': rows, 'sources': used}, lines, args.json)
    return 0


def bridge(args):
    cat = load_catalogue()
    prof = args.profession.casefold()
    if prof not in cat['professions'] or args.start >= args.end:
        raise Failure('bridge requires a catalogue profession and start < end', 2)
    rows = [r for p, r in recipes(cat) if p == prof and r['bands']['learn'] <= args.end and (r['bands']['grey'] is None or r['bands']['grey'] > args.start)]
    cuts = sorted({args.start, args.end} | {r['bands']['learn'] for r in rows if args.start < r['bands']['learn'] < args.end})
    segments, lines = [], [f'{prof} bridge {args.start} -> {args.end}']
    for a, b in zip(cuts, cuts[1:]):
        live = [r for r in rows if r['bands']['learn'] <= a and (r['bands']['grey'] is None or r['bands']['grey'] > a) and r['source_type'] != 'Not yet known']
        def priority(r):
            st = r['source_type'] or ''
            return (0 if 'Trainer' in st or 'Automatic' in st else 1 if 'Vendor' in st else 2 if 'Drop' in st else 3,
                    {'orange':0,'yellow':1,'green':2}.get(catalogue.color_at(r['bands'],a),3), -r['bands']['learn'])
        live.sort(key=priority)
        segments.append({'from_level':a,'to_level':b,'recipes':live[:12]})
        lines.append(f'{a}-{b}:')
        lines += [f"  {r['name']} {catalogue.color_at(r['bands'],a)} learn {r['bands']['learn']} grey {human(r['bands']['grey'])} {human(r['source_type'])}" for r in live[:12]]
    emit({'profession':prof,'segments':segments,'sources':[catalogue_source(cat)]},lines,args.json)
    return 0


def margins(args):
    cat = load_catalogue()
    if args.known:
        print('deprecated --known; use --char',file=sys.stderr)
        if args.char and args.char != args.known:
            raise Failure('--known conflicts with --char',2)
        args.char = args.known
    used = [catalogue_source(cat)]
    ch = None
    if args.char:
        d = roster(character_path(args.char))
        ch = d.get('character',d)
        used += sources(d)
    profs = [args.profession.casefold()] if args.profession else list(cat['professions'])
    if any(p not in cat['professions'] for p in profs):
        raise Failure('unknown profession; choose ' + ', '.join(cat['professions']),2)
    prices, ms = market_table()
    used.append(ms)
    rows = []
    for prof in profs:
        skill = args.level
        known = None
        if ch:
            known = catalogue.char_known_ids(ch,prof)
            if known is None:
                if args.profession:
                    raise Failure(f'roster has no recipe data for {args.char} {prof}; craftable set unknown')
                continue
            if skill is None:
                skill = next((p.get('skill') for p in ch['professions'] if p['name'].casefold()==prof and p.get('skill_available')),None)
                if skill is None:
                    raise Failure(f'roster skill unavailable for {prof}; pass --level N',2)
        for r in cat['professions'][prof]['recipes']:
            if known is not None and r['spell_id'] not in known or skill is not None and r['bands']['learn'] > skill:
                continue
            rp = prices.get(r['result']['item_id'],{})
            if rp.get('median_copper') is None:
                continue
            reagents = []
            for x in r['reagents']:
                cost = prices.get(x['item_id'],{}).get('median_copper')
                reagents.append({**x,'unit_copper':cost,'basis':'AHledger'})
            if any(x['unit_copper'] is None for x in reagents):
                continue
            cost = sum(x['unit_copper']*x['qty'] for x in reagents)
            margin = round(rp['median_copper'] * r['result']['qty'] * 0.95) - cost
            rows.append({'name':r['name'],'profession':prof,'spell_id':r['spell_id'],
                'color':catalogue.color_at(r['bands'],skill) if skill is not None else None,
                'margin_copper':margin,'cost_copper':cost,'sells_copper':rp['median_copper'],
                'sales_per_day':rp['sales_per_day'],'reagents':reagents,'source_type':r['source_type']})
    rows.sort(key=lambda r: ({'orange':0,'yellow':1,'green':2,'grey':3}.get(r['color'],4),-(r['margin_copper']*(r['sales_per_day'] or 0) if r['margin_copper']>0 else r['margin_copper'])))
    rows=rows[:15]
    emit({'margins':rows,'sources':used},[f"{r['name']} [{r['profession']}] {human(r['color'])} | margin {money(r['margin_copper'])} | cost {money(r['cost_copper'])} | sells {money(r['sells_copper'])} | {str(r['sales_per_day']) + '/day' if r['sales_per_day'] is not None else 'sales/day unknown'} | {human(r['source_type'])}" for r in rows] or ['no priced recipes'],args.json)
    return stale_code(used)


def char(args):
    if args.profession == 'auctions':
        raise Failure(f'Use: everledger listings --char "{args.name}"',2)
    data=roster(character_path(args.name) if args.name else '/characters')
    used=sources(data)
    if args.name:
        if args.profession:
            cat=load_catalogue()
            used.append(catalogue_source(cat))
        else:
            cat={'professions':{}}
        argv=[args.name]+([args.profession] if args.profession else [])+(['--skill',str(args.skill)] if args.skill is not None else [])
        _,lines=capture(catalogue.cmd_char,cat,argv,data)
    else:
        lines=[f"{human(c.get('name'))} | level {human(c.get('level'))} {human(c.get('race'))} {human(c.get('class'))} | gold {money(c.get('gold_copper'))}" for c in data.get('characters',[])] or ['no characters recorded']
    emit({**data,'sources':used},lines,args.json)
    return 0


def outcome(args):
    item=item_for(args.item) if args.item else None
    if args.command=='events':
        params=outcomes.event_params(args)
        params['item']=item
        if args.cursor:
            if any((args.after is not None, args.since, args.until, args.char, args.item, args.type, args.venue)):
                raise Failure('--cursor inherits filters; supply only --cursor and --limit',2)
            params={'cursor':args.cursor,'limit':args.limit}
        data=outcomes.fetch_events(params)
        disclose_item_source(data,item)
        lines=outcomes.event_lines(outcomes.event_rows(data)) if data.get('available') is not False else [f"journal {human(data.get('state'))}: {human(data.get('reason'))}"]
        emit(data,lines+[f"next_cursor: {human(data.get('next_cursor'))} | has_more: {human(data.get('has_more'))} | after_cursor: {human(data.get('after_cursor'))} | checkpoint: {human(data.get('checkpoint'))}"],args.json)
        return 0
    types={'sales':'sale','purchases':'purchase','expirations':'expiration'}
    data=outcomes.item_events(args,item,types[args.command])
    rows=data.pop('events',[])
    lines=outcomes.event_lines(rows)
    if args.command=='sales':
        data['proceeds_copper']=outcomes.total(rows,'proceeds_copper') if data.get('available') is not False else None
        lines.append('total proceeds ' + money(data['proceeds_copper']))
    if args.command=='expirations' and rows:
        prices,ms=market_table()
        data['sources']=sources(data)+[ms]
        for r in rows:
            iid=(r.get('item') or {}).get('id')
            r['market']=prices.get(iid)
            if r['market']:
                lines.append(f"  repost input: floor {money(r['market']['floor_copper'])} | listed {human(r['market']['quantity'])} | sales/day {human(r['market']['sales_per_day'])}")
    data[args.command]=rows
    if data.get('available') is False:
        lines.append(f"journal {human(data.get('state'))}: {human(data.get('reason'))}")
    disclose_item_source(data,item)
    emit(data,lines,args.json)
    return 0


def status(args):
    rows=[]; used=[]; roster_sources=[]; code=0
    try:
        cat=load_catalogue()
        checked,lines=capture(catalogue.cmd_verify,cat,[])
        s=catalogue_source(cat); used.append(s)
        rows.append({'source':'catalogue','state':'ok' if not checked else 'anchor failure','updated_at':cat['generated_at'],'checks':lines})
        code=max(code,checked)
    except Failure as e:
        rows.append({'source':'catalogue','state':str(e)}); code=max(code,e.code)
    for label,path in [('roster','/characters'),('outcomes','/events'),('listings','/listings')]:
        try:
            d=outcomes.fetch_events({'limit':0}) if label=='outcomes' else roster(path)
            used+=sources(d)
            roster_sources+=sources(d)
            rows.append({'source':label,'state':d.get('state','reachable'),'sources':sources(d)})
            if label=='listings': code=max(code,stale_code(outcomes.listing_sources(d)))
        except Failure as e:
            rows.append({'source':label,'state':str(e)}); code=max(code,e.code)
    try:
        _,s=market_table(); used.append(s); rows.append({'source':'AHledger','state':'stale' if s['stale'] else 'reachable',**s}); code=max(code,stale_code([s]))
    except Failure as e:
        rows.append({'source':'AHledger','state':str(e)}); code=max(code,e.code)
    vendor_status, vendor_sources = vendors.backend_status()
    if vendor_status['backend'] == vendors.BACKEND:
        try:
            request(vendors.BASE, vendors.UA)
            vendor_status['state'] = 'reachable'
        except Failure as e:
            vendor_status['state'] = str(e); code=max(code,e.code)
    used += vendor_sources
    code = max(code, stale_code(vendor_sources))
    rows.append(vendor_status)
    lines=[' | '.join([human(r['source'])] + ([human(r['backend'])] if r.get('backend') else []) + [human(r['state'])]) for r in rows]
    info = vendor_status['foreverdb']
    lines.append(f"ForeverDB {info['state']} | transport {info['transport'] or 'none'} | last sync {info['last_sync_at'] or 'never'} | {info['record_count']} vendor records | {info['item_count']} item records | pending {human(info['pending'])}")
    ninja_coverage = vendor_status['coverage'][vendors.BACKEND]
    lines.append(f"wowforever.ninja cache | {ninja_coverage['record_count']} vendor records | {ninja_coverage['item_count']} item records")
    if not vendor_status['cache_items'] and not vendor_status['published_at']:
        lines.append('vendors data: no cache yet')
    else:
        lines.append(f"vendors data {human(vendor_status['published_at'])} | cache {vendor_status['cache_items']} items | {vendor_status['seen']} seen, {vendor_status['baseline']} baseline, {vendor_status['unverified']} unverified")
    emit({'status':rows,'sources':used},lines,args.json, source_families={'roster service':roster_sources})
    return code


def refresh(args):
    if args.target is None:
        print('deprecated bare refresh; use: everledger refresh catalogue',file=sys.stderr)
    result=subprocess.run(['bash',str(Path(__file__).resolve().parent/'refresh.sh')],capture_output=True,text=True)
    if result.returncode:
        print(result.stderr or result.stdout,file=sys.stderr)
        return 4 if 'curl:' in result.stderr else 1
    if result.stderr: print(result.stderr,end='',file=sys.stderr)
    used=[catalogue_source(load_catalogue())]
    code=0
    vendor_sources, synced = vendors.refresh_cached()
    used += vendor_sources
    code = max(code, stale_code(vendor_sources))
    if synced.get('failed') and not vendor_sources:
        code = max(code, 4)
    lines = ['catalogue refreshed']
    if synced.get('configured'):
        lines.append(f"ForeverDB sync: {'complete' if synced['complete'] else 'pending'}; {synced.get('requests', 0)} requests this refresh")
    emit({'refreshed':'catalogue','vendor_sync':synced,'sources':used},lines,args.json)
    return code


def main(argv=None):
    args=parser().parse_args(argv)
    try:
        if args.command=='events':
            if args.limit is None and args.cursor is None: args.limit=500 if args.json else 50
            if args.cursor == '': raise Failure('empty --cursor; pass next_cursor from the previous page',2)
            if args.limit is not None and args.limit<0: raise Failure('--limit must be nonnegative',2)
        if args.command in ('price','recipe','bridge','margins','char','status','refresh'):
            return globals()[args.command](args)
        if args.command=='verify':
            print('deprecated verify; use: everledger status',file=sys.stderr)
            cat=load_catalogue(); code,lines=capture(catalogue.cmd_verify,cat,[])
            emit({'ok':code==0,'checks':lines,'sources':[catalogue_source(cat)]},lines,args.json)
            return code
        if args.command=='vendors':
            item=item_for(' '.join(args.item)); data=vendors.lookup(item['id'])
            disclose_item_source(data,item)
            if args.zone: data=vendors.select_zone(data,args.zone)
            emit(vendors.public(data),vendors.lines(data),args.json)
            return stale_code(data['sources'])
        if args.command=='listings':
            item=item_for(args.item) if args.item else None
            prices,ms=market_table()
            data=outcomes.listings({'char':args.char,'item':str(item['id']) if item else None},prices)
            data['sources']=sources(data)+[ms]
            disclose_item_source(data,item)
            code=stale_code([ms]+outcomes.listing_sources(data))
            emit(data,outcomes.listing_lines(data),args.json,stale=code==3)
            return code
        if args.command=='positions':
            args.since=args.until=None
            item=item_for(args.item) if args.item else None
            prices,ms=market_table()
            data,lines=outcomes.positions(args,item,prices,ms)
            disclose_item_source(data,item)
            emit(data,lines,args.json,stale=data['stale'])
            return 3 if data['stale'] else 0
        if args.command=='net':
            cat=load_catalogue(); item=item_for(' '.join(args.item))
            data,lines=outcomes.net(args,item,catalogue_source(cat),cat)
            emit(data,lines,args.json)
            return 0
        return outcome(args)
    except Failure as e:
        print(str(e),file=sys.stderr)
        if e.body and e.body.get('response'):
            print(json.dumps(e.body['response']),file=sys.stderr)
        return e.code
    except (OSError,ValueError,KeyError,TypeError) as e:
        print(f'error: {e}',file=sys.stderr)
        return 1

if __name__=='__main__':
    sys.exit(main())
